{
  "name": "sciencediscovery-website",
  "private": true,
  "type": "module",
  "scripts": {
    "fetch:docs": "node scripts/fetch-docs.mjs",
    "build": "node scripts/fetch-docs.mjs --if-missing && node site/build.mjs && node scripts/check-site.mjs",
    "dev": "npm run build && node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs"
  },
  "dependencies": {
    "github-slugger": "2.0.0",
    "highlight.js": "11.11.1",
    "marked": "15.0.12"
  },
  "devDependencies": {
    "parse5": "7.3.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
